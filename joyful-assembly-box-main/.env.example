# Server-side AI configuration (do NOT commit your real keys)
#
# For local dev, set these as environment variables before running `npm run dev`.
# On Windows PowerShell:
#   $env:ANTHROPIC_API_KEY = "..."
#   npm run dev
#
# Or create a `.env.local` (gitignored) with the same variables.

# Free unlimited local mode (no keys)
#
# AI_PROVIDER=local

# Recommended "$0 hosted" option (Gemini free tier; quotas apply)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Prefer Anthropic Claude (paid; rate-limited by provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Optional: OpenAI fallback (paid; rate-limited by provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (OpenAI-compatible; you provide an OpenRouter API key)
# Model names look like: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-lite
# You can also provide a fallback list separated by commas or | and the server will try each in order.
# Example (swap for any current ":free" slugs you see on https://openrouter.ai/models):
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free, qwen/qwen2.5-7b-instruct:free, mistralai/mistral-7b-instruct:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional attribution headers (recommended by OpenRouter)
OPENROUTER_SITE_URL=http://localhost:8081
OPENROUTER_APP_NAME=LearnAdapt

# Optional: force provider (local|gemini|anthropic|openrouter|openai)
AI_PROVIDER=

# --- Spring backend (local dev) ---
#
# The frontend server (TanStack Start) will proxy browser requests under `/api/*`
# to the correct Spring service based on the path, EXCEPT `/api/ai/*` which is
# handled by the frontend's own AI routes.
#
# Defaults (if unset):
#   AUTH_SERVICE_URL=http://localhost:8081
#   COURSE_SERVICE_URL=http://localhost:8082
#   QUIZ_SERVICE_URL=http://localhost:8083
#   NOTIFICATION_SERVICE_URL=http://localhost:8084
#   ANALYTICS_SERVICE_URL=http://localhost:8085
#   PLATFORM_SERVICE_URL=http://localhost:8087

AUTH_SERVICE_URL=
COURSE_SERVICE_URL=
QUIZ_SERVICE_URL=
NOTIFICATION_SERVICE_URL=
ANALYTICS_SERVICE_URL=
PLATFORM_SERVICE_URL=

# Optional (local dev): header-based auth injection
#
# Some backend services (e.g. quiz-service) authenticate requests using these
# headers:
#   X-User-Id
#   X-User-Role (LEARNER|TEACHER|ADMIN)
#
# If you set the following, the frontend server will automatically inject them
# into proxied `/api/*` requests when the browser doesn't provide them.
DEV_USER_ID=
DEV_USER_ROLE=
